[sub_resource type="GDScript" id="GDScript_b3cg4"]
script/source = "extends Control

@onready var slot_bg: TextureRect = $SlotBg
@onready var icon: TextureRect = $Icon
@onready var count_label: Label = $CountLabel
@onready var lock_overlay: TextureRect = $LockOverlay

func set_slot_data(crop_texture: Texture2D, count: int, is_locked: bool = false) -> void:
	if is_locked:
		icon.hide()
		count_label.hide()
		lock_overlay.show()
	else:
		lock_overlay.hide()
		if count > 0 and crop_texture != null:
			icon.texture = crop_texture
			icon.show()
			count_label.text = \"x\" + str(count)
			count_label.show()
		else:
			# Unlocked but empty slot
			icon.hide()
			count_label.hide()
"

